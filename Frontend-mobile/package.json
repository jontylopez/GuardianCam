{
  "name": "guardiancammobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "ip=$(node ../scripts/detect-ip.js) EXPO_PUBLIC_LIVE_DASHBOARD_URL=http://$ip:3000 EXPO_PUBLIC_API_BASE_URL=http://$ip:5000 expo start",
    "start:emu": "EXPO_PUBLIC_LIVE_DASHBOARD_URL=http://10.0.2.2:3000 EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000 expo start --lan",
    "start:ios-sim": "EXPO_PUBLIC_LIVE_DASHBOARD_URL=http://127.0.0.1:3000 EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5000 expo start --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@livekit/react-native": "^2.9.1",
    "@livekit/react-native-webrtc": "^137.0.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.5",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.5",
    "axios": "^1.11.0",
    "expo": "~53.0.20",
    "expo-av": "^15.1.7",
    "expo-camera": "^16.1.11",
    "expo-dev-client": "~5.2.4",
    "expo-media-library": "^17.1.7",
    "expo-notifications": "~0.31.4",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "^2.27.2",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.13.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-webview": "^13.15.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.0.10",
    "expo-build-properties": "^0.14.8",
    "typescript": "~5.8.3"
  },
  "private": true
}
