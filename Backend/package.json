{
  "name": "guardiancam-backend",
  "version": "1.0.0",
  "description": "Backend for GuardianCam - Elderly Fall Detection System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "ip=$(node ../scripts/detect-ip.js) LAN_IP=$ip ALLOW_ANY_ORIGIN=true ALLOWED_ORIGINS=http://$ip:3000 nodemon server.js",
    "test": "jest",
    "test-setup": "node test-setup.js"
  },
  "keywords": [
    "fall-detection",
    "elderly-care",
    "security",
    "monitoring"
  ],
  "author": "GuardianCam Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.4.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
